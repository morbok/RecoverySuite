# Development packages contain applications and documentation, not SDK headers.
install(FILES README.md docs/RELEASE_QA.md docs/USER_GUIDE.md docs/THIRD_PARTY_NOTICES.md docs/RELEASE_ACCEPTANCE.md DESTINATION share/doc/recoverysuite COMPONENT Runtime)
if(UNIX AND NOT APPLE)
    install(FILES packaging/recoverysuite.desktop DESTINATION share/applications COMPONENT Runtime)
    install(FILES packaging/recoverysuite.svg DESTINATION share/icons/hicolor/scalable/apps COMPONENT Runtime)
endif()
if(WIN32)
    install(DIRECTORY "${CMAKE_BINARY_DIR}/runtime-notices/" DESTINATION share/doc/recoverysuite/third-party COMPONENT Runtime)
    get_target_property(_qt_qmake Qt6::qmake IMPORTED_LOCATION)
    get_filename_component(_qt_bin "${_qt_qmake}" DIRECTORY)
    find_program(RECOVERYSUITE_WINDEPLOYQT windeployqt HINTS "${_qt_bin}" REQUIRED)
    # The official VC redistributable is a documented prerequisite; do not copy compiler DLLs.
    install(CODE "
        execute_process(COMMAND \"${RECOVERYSUITE_WINDEPLOYQT}\" --release --no-translations --no-compiler-runtime
            \"\${CMAKE_INSTALL_PREFIX}/bin/RecoverySuite_GUI.exe\" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR \"windeployqt failed: \${result}\")
        endif()
    " COMPONENT Runtime)
endif()
set(CPACK_PACKAGE_NAME "RecoverySuite")
set(CPACK_PACKAGE_VENDOR "RecoverySuite contributors")
set(CPACK_PACKAGE_CONTACT "https://github.com/morbok/RecoverySuite/issues")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/morbok/RecoverySuite")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "General disk data recovery with read-only source access")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}~dev")
set(CPACK_PACKAGE_FILE_NAME "RecoverySuite-${PROJECT_VERSION}-dev-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_COMPONENTS_ALL Runtime)
set(CPACK_COMPONENTS_GROUPING ALL_COMPONENTS_IN_ONE)
set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)
set(CPACK_DEB_COMPONENT_INSTALL ON)
set(CPACK_PACKAGE_CHECKSUM SHA256)
if(WIN32)
    set(CPACK_GENERATOR ZIP)
else()
    set(CPACK_GENERATOR TGZ)
    set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
    set(CPACK_DEBIAN_PACKAGE_NAME recoverysuite)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_SECTION utils)
    set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "udisks2, polkitd")
endif()
include(CPack)
