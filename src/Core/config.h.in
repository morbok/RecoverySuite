#ifndef RECOVERYSUITE_CONFIG_H
#define RECOVERYSUITE_CONFIG_H

/* RecoverySuite Version */
#define RECOVERYSUITE_VERSION_MAJOR @RECOVERY_SUITE_VERSION_MAJOR@
#define RECOVERY_SUITE_VERSION_MINOR @RECOVERY_SUITE_VERSION_MINOR@
#define RECOVERY_SUITE_VERSION_PATCH @RECOVERY_SUITE_VERSION_PATCH@

/* Compiler Information */
#if defined(_MSC_VER)
    #define RECOVERYSUITE_COMPILER_MSVC
#elif defined(__clang__)
    #define RECOVERYSUITE_COMPILER_CLANG
#elif defined(__GNUC__)
    #define RECOVERYSUITE_COMPILER_GCC
#endif

/* Platform Information */
#if defined(_WIN32) || defined(_WIN64)
    #define RECOVERYSUITE_PLATFORM_WINDOWS
#elif defined(__APPLE__)
    #define RECOVERYSUITE_PLATFORM_MACOS
#elif defined(__linux__)
    #define RECOVERYSUITE_PLATFORM_LINUX
#endif

/* Build Type Information */
#ifdef NDEBUG
    #define RECOVERYSUITE_BUILD_RELEASE
#else
    #define RECOVERYSUITE_BUILD_DEBUG
#endif

#endif // RECOVERYSUITE_CONFIG_H